<% content_for :title, "Sign in | User Management" %>
<div class="auth-wrap">
  <div class="card border-0 shadow-sm auth-card">
    <div class="card-body p-4 p-md-5">
      <h1 class="h3 fw-semibold mb-2">Sign in</h1>
      <p class="text-secondary mb-4">Enter your account details to continue.</p>
      <%= form_with url: login_path, method: :post, data: { turbo: false } do |form| %>
        <div class="mb-3">
          <%= form.label :email, "Email address", class: "form-label" %>
          <%= form.email_field :email, class: "form-control", required: true, autocomplete: "email", autofocus: true %>
        </div>
        <div class="mb-4">
          <%= form.label :password, "Password", class: "form-label" %>
          <%= form.password_field :password, class: "form-control", required: true, autocomplete: "current-password" %>
        </div>
        <%= form.submit "Sign in", class: "btn btn-primary w-100" %>
      <% end %>
      <p class="small text-secondary mt-4 mb-0">Don't have an account? <%= link_to "Create account", register_path, data: { turbo: false } %></p>
    </div>
  </div>
</div>
